[Desktop Entry]
Type=Application
X-Nemo-Application-Type=no-invoker
# Kein Booster. Der Booster von mapplauncherd laedt die Anwendung mit dlopen
# in einen vorgewaermten Prozess; das setzt eine Binaerdatei voraus, die sich
# laden laesst (-pie -rdynamic). Diese hier ist eine gewoehnliche ausfuehrbare
# Datei, und solange die App im Sandkasten lief, fiel das nicht auf: Sailjail
# startet sie selbst und fuehrt sie einfach aus. Ohne Sandkasten (unten) geht
# der Start wieder ueber den Booster -- und der scheitert mit
# "Kann das Programm nicht dynamisch Laden", sichtbar nur im Journal, waehrend
# im App-Raster gar nichts passiert.
#
# Deshalb hier ausdruecklich kein Invoker, so wie beim 0-A.-D.-Port, der aus
# demselben Grund ohne Sandkasten laeuft.
Icon=harbour-clehrer
Exec=harbour-clehrer
Name=C-Lehrer
Comment=C, C++, Rust und Python lernen — mit Blick auf Simulation
Categories=Education;

[X-Sailjail]
# Genau diese Kennung gibt die Sandbox frei -- main.cpp setzt dieselben
# beiden Namen. Weicht eines davon ab, merkt sich die App beim Start über
# das Symbol nichts: kein Fortschritt, keine Einstufung, keine Karteikarten.
OrganizationName=harbour-clehrer
ApplicationName=harbour-clehrer
# Ohne Sandkasten, und zwar aus dem Grund, aus dem es diese App gibt.
#
# Sailjail baut /usr/bin im Sandkasten neu auf: sichtbar ist nur, was eine
# Berechtigung ausdruecklich freigibt (firejail private-bin). Freigegeben
# ist im ganzen System weder python3 noch g++ -- kein einziges
# Berechtigungsprofil in /etc/sailjail/permissions nennt sie. Drinnen gibt
# es sie also nicht, und die Spielwiese bot folgerichtig nur C und Rust an:
# deren Deuter liegen in /usr/libexec/harbour-clehrer und gehoeren der App
# selbst.
#
# Ein Sandkasten, der das Ausfuehren fremden Programmtextes verhindert,
# verhindert hier genau die Aufgabe: Der Kurs lebt davon, dass der Code,
# den der Lernende schreibt, wirklich laeuft. Die Kennung oben bleibt
# stehen, damit der Fortschritt weiter unter
# ~/.local/share/harbour-clehrer liegt.
#
# Segelschein und Segelflug fuehren nichts aus und bleiben im Sandkasten.
Sandboxing=Disabled
